# Lance storage
#
# Dagster assets are stored as LanceDB tables (one table per asset).
#
# LANCE_URI is a local directory (default ./data/lance) or an S3 path.
# For S3, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are required;
# AWS_ENDPOINT_URL (or AWS_ENDPOINT), AWS_REGION and AWS_ALLOW_HTTP are optional.

# --- Local dev mode (files on disk, nothing else needed) ---
LANCE_URI=./data/lance

# Raw input files follow the fixed convention:
# ./data/raw/<project>/...

# --- S3 mode (production, or a shared database) ---
# LANCE_URI=s3://bucket/path
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_ENDPOINT_URL=https://data.systems-sciences.uni-graz.at
# AWS_REGION=us-east-1

# --- LanceDB on SeaweedFS (production) ---
# Without IKARIAM_LANCEDB_PATH, ikariam writes to ikariam/output/ikariam.lancedb.
# LanceDB reads the AWS_* variables natively. The containers reach SeaweedFS
# over the external sywi-infra Docker network.
# IKARIAM_LANCEDB_PATH=s3://ikariam/ikariam.lancedb
# AWS_ENDPOINT=http://seaweedfs:8333
# AWS_REGION=us-east-1
# AWS_ALLOW_HTTP=true
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Remote Lance databases (for `just db` and `just pull`) ---
# Attached next to your local database, and the source for `just pull <table>`.
# Uses the same AWS_* credentials as above. One URI is attached as `remote`;
# several are comma separated `name=uri` pairs, attached under their names:
# LANCE_REMOTE_URI=s3://ikariam/ikariam.lancedb
# LANCE_REMOTE_URI=ikariam=s3://ikariam/ikariam.lancedb,hackernews=s3://hackernews/lance

# --- Project Selection (for local development) ---
# Comma-separated list of projects to start with 'just up' / 'uv run dev up'.
# Leave empty or comment out to start all projects defined in dg.toml.
# Example: DEV_PROJECTS=hackernews
# DEV_PROJECTS=
