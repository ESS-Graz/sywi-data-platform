# Generated files
*.generated.yaml
workspace.generated.yaml

# Environment variables (contains secrets)
.env
.env.local

# Local dev outputs
**/raw_data/
**/output/

# Python
__pycache__/
*.pyc
.venv/

# IDE
.idea/
.vscode/

# Local data and bind-mounted raw inputs.
# Listed as data/* rather than data/ so Git descends into the tree and the
# small, hand-maintained lookup file below can be re-included. Git cannot
# re-include a file whose parent directory is excluded, hence one negation per
# path level. Everything else under data/, including all raw snapshots, stays
# ignored.
data/*
!data/raw/
data/raw/*
!data/raw/ikariam/
data/raw/ikariam/*
!data/raw/ikariam/building_costs.csv

# Temp dir
temp/
docs-temp/

# Dagster local state
.dagster/
